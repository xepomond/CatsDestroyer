#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
PW Cats Profit - Scanner & Arbitrage Tracker for dbase.pwclassic.net/cats
Tracks price differences, finds arbitrage opportunities, updates WebApp data,
and sends instant alerts to Telegram.
"""

import os
import sys
import json
import time
import datetime
from concurrent.futures import ThreadPoolExecutor, as_completed
import requests
from bs4 import BeautifulSoup

# Fix Windows console encoding if needed
if sys.platform == "win32":
    try:
        sys.stdout.reconfigure(encoding='utf-8')
    except Exception:
        pass
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
ITEMS_DB_PATH = os.path.join(BASE_DIR, "items_db.json")
SITE_DIR = os.path.join(BASE_DIR, "site")
DATA_JSON_PATH = os.path.join(SITE_DIR, "data.json")
CACHE_FILE_PATH = os.path.join(BASE_DIR, "alert_cache.json")

TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "").strip()
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID", "").strip()
WEBAPP_URL = os.getenv("WEBAPP_URL", "").strip()  # e.g. https://username.github.io/pw-cats-profit/

MIN_PROFIT_ALERT = int(os.getenv("MIN_PROFIT_ALERT", "30000"))  # Coins minimum profit to trigger alert
MIN_MARGIN_ALERT = float(os.getenv("MIN_MARGIN_ALERT", "5.0"))  # Minimum % profit margin
MAX_WORKERS = int(os.getenv("MAX_WORKERS", "4"))
SCAN_LIMIT = int(os.getenv("SCAN_LIMIT", "0"))  # 0 means scan all items

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Accept": "application/json, text/html, */*",
    "Accept-Language": "en-US,en;q=0.9",
}

def load_items():
    if not os.path.exists(ITEMS_DB_PATH):
        print(f"[!] {ITEMS_DB_PATH} not found!")
        return []
    with open(ITEMS_DB_PATH, "r", encoding="utf-8-sig") as f:
        return json.load(f)

def fetch_item_stats(item, session):
    item_id = item["id"]
    url = f"https://dbase.pwclassic.net/api/price-stats/item/{item_id}/history?days=1"
    for attempt in range(4):
        try:
            r = session.get(url, headers=HEADERS, timeout=12)
            if r.status_code == 200:
                data = r.json()
                latest = data.get("latest") or {}
                
                def to_float(val):
                    try:
                        return float(val) if val is not None else 0.0
                    except (ValueError, TypeError):
                        return 0.0

                return {
                    **item,
                    "min_sell": latest.get("min_sell_price") or 0,
                    "max_sell": latest.get("max_sell_price") or 0,
                    "avg_sell": to_float(latest.get("avg_sell_price")),
                    "median_sell": to_float(latest.get("median_sell_price")),
                    "min_buy": latest.get("min_buy_price") or 0,
                    "max_buy": latest.get("max_buy_price") or 0,
                    "avg_buy": to_float(latest.get("avg_buy_price")),
                    "median_buy": to_float(latest.get("median_buy_price")),
                    "collected_at": latest.get("collected_at", "")
                }
            elif r.status_code == 429:
                retry_after = int(r.headers.get("retry-after", "2"))
                time.sleep(retry_after + 1)
                continue
            elif r.status_code in (404, 500):
                return None
        except Exception:
            time.sleep(1)
        time.sleep(0.15)
    return None

def fetch_cat_details(item_id, session):
    """
    Parses detailed cats table for specific item to find exact seller & buyer cats.
    """
    url = f"https://dbase.pwclassic.net/cats/item/{item_id}?server=classic"
    sellers = []
    buyers = []
    try:
        r = session.get(url, headers=HEADERS, timeout=15)
        r.encoding = "utf-8"
        if r.status_code != 200:
            return sellers, buyers

        soup = BeautifulSoup(r.text, "html.parser")
        table = soup.find("table", id="catsTable")
        if not table:
            return sellers, buyers

        tbody = table.find("tbody")
        if not tbody:
            return sellers, buyers

        for row in tbody.find_all("tr"):
            cols = row.find_all("td")
            if len(cols) < 7:
                continue

            nick = cols[0].get_text(strip=True)
            shop_a = cols[1].find("a")
            shop_name = shop_a.get_text(strip=True) if shop_a else ""
            shop_span = cols[1].find("span", attrs={"data-clipboard-text": True})
            coords = shop_span["data-clipboard-text"].strip() if shop_span else ""

            def clean_num(td):
                txt = td.get_text(strip=True).replace(" ", "").replace("\xa0", "")
                return int(txt) if txt.isdigit() else 0

            sell_price = clean_num(cols[3])
            sell_qty = clean_num(cols[4])
            buy_price = clean_num(cols[5])
            buy_qty = clean_num(cols[6])

            if sell_price > 0 and sell_qty > 0:
                sellers.append({
                    "nick": nick,
                    "shop": shop_name,
                    "coords": coords,
                    "price": sell_price,
                    "qty": sell_qty
                })

            if buy_price > 0 and buy_qty > 0:
                buyers.append({
                    "nick": nick,
                    "shop": shop_name,
                    "coords": coords,
                    "price": buy_price,
                    "qty": buy_qty
                })

        sellers.sort(key=lambda x: x["price"])
        buyers.sort(key=lambda x: x["price"], reverse=True)
    except Exception as e:
        print(f"[!] Error fetching cat details for item {item_id}: {e}")

    return sellers, buyers

def load_alert_cache():
    if os.path.exists(CACHE_FILE_PATH):
        try:
            with open(CACHE_FILE_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def save_alert_cache(cache):
    try:
        with open(CACHE_FILE_PATH, "w", encoding="utf-8") as f:
            json.dump(cache, f, ensure_ascii=False, indent=2)
    except Exception as e:
        print(f"[!] Error saving alert cache: {e}")

def send_telegram_message(text, webapp_url=None):
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        print("[i] Telegram token or chat ID not set. Skipping message.")
        return False

    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": text,
        "parse_mode": "HTML",
        "disable_web_page_preview": True
    }

    if webapp_url:
        payload["reply_markup"] = {
            "inline_keyboard": [
                [
                    {"text": "📊 Открыть Web-панель", "web_app": {"url": webapp_url}}
                ]
            ]
        }

    try:
        res = requests.post(url, json=payload, timeout=10)
        if res.status_code == 200:
            print("[+] Telegram message sent successfully.")
            return True
        else:
            print(f"[!] Telegram API error {res.status_code}: {res.text}")
    except Exception as e:
        print(f"[!] Telegram request failed: {e}")
    return False

def format_coins(val):
    return f"{val:,}".replace(",", " ")

def main():
    print(f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] Starting PW Cats Profit Scanner...")
    os.makedirs(SITE_DIR, exist_ok=True)

    items = load_items()
    if not items:
        print("[!] No items to scan!")
        return

    if SCAN_LIMIT > 0:
        items = items[:SCAN_LIMIT]

    print(f"[*] Loaded {len(items)} items from database. Scanning API...")
    
    scanned_items = []
    session = requests.Session()
    
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        future_to_item = {executor.submit(fetch_item_stats, it, session): it for it in items}
        for future in as_completed(future_to_item):
            res = future.result()
            if res:
                scanned_items.append(res)

    print(f"[*] Successfully scanned {len(scanned_items)} items.")

    # 1. Detect Arbitrage (min_sell < max_buy)
    arbitrage_candidates = []
    bargain_deals = []

    for item in scanned_items:
        sell = item["min_sell"]
        buy = item["max_buy"]
        median_sell = item["median_sell"]

        # Check pure arbitrage
        if sell > 0 and buy > 0 and sell < buy:
            diff = buy - sell
            margin = (diff / sell) * 100.0
            arbitrage_candidates.append({
                **item,
                "profit_per_unit": diff,
                "margin_pct": round(margin, 1)
            })

        # Check bargain / dumping (selling >= 30% below 24h median price)
        if sell > 0 and median_sell > 5000 and sell <= (median_sell * 0.7):
            discount_pct = round(((median_sell - sell) / median_sell) * 100.0, 1)
            bargain_deals.append({
                **item,
                "discount_pct": discount_pct,
                "diff_from_median": int(median_sell - sell)
            })

    print(f"[*] Found {len(arbitrage_candidates)} potential arbitrage items. Fetching specific cats...")

    # Fetch cats for arbitrage deals
    active_arbitrage = []
    for cand in arbitrage_candidates:
        sellers, buyers = fetch_cat_details(cand["id"], session)
        if sellers and buyers and sellers[0]["price"] < buyers[0]["price"]:
            best_seller = sellers[0]
            best_buyer = buyers[0]
            profit_unit = best_buyer["price"] - best_seller["price"]
            exec_qty = min(best_seller["qty"], best_buyer["qty"])
            total_profit = profit_unit * exec_qty
            margin = (profit_unit / best_seller["price"]) * 100.0

            active_arbitrage.append({
                "id": cand["id"],
                "name": cand["name"],
                "category": cand["category"],
                "icon": cand["icon"],
                "seller": best_seller,
                "buyer": best_buyer,
                "profit_per_unit": profit_unit,
                "executable_qty": exec_qty,
                "total_profit": total_profit,
                "margin_pct": round(margin, 1),
                "url": f"https://dbase.pwclassic.net/cats/item/{cand['id']}?server=classic"
            })
        time.sleep(0.1)

    # Sort arbitrage by total profit descending
    active_arbitrage.sort(key=lambda x: x["total_profit"], reverse=True)
    bargain_deals.sort(key=lambda x: x["diff_from_median"], reverse=True)

    print(f"[+] Active Arbitrage Deals: {len(active_arbitrage)}")
    print(f"[+] Bargain Deals: {len(bargain_deals)}")

    # 2. Telegram Alert Processing
    alert_cache = load_alert_cache()
    current_time_str = datetime.datetime.now().strftime("%H:%M")
    new_alerts_sent = 0

    for deal in active_arbitrage:
        deal_id = f"{deal['id']}_{deal['seller']['price']}_{deal['buyer']['price']}"
        # Skip if already alerted recently with same prices
        last_alert_time = alert_cache.get(deal_id)
        if last_alert_time:
            continue

        # Check thresholds
        if deal["total_profit"] >= MIN_PROFIT_ALERT or deal["margin_pct"] >= MIN_MARGIN_ALERT:
            msg = (
                f"🚨 <b>АРБИТРАЖ PW CLASSIC!</b>\n"
                f"📦 <b>{deal['name']}</b> ({deal['category']})\n\n"
                f"🟢 <b>КУПИТЬ ДЕШЕВО:</b>\n"
                f"• Цена: <b>{format_coins(deal['seller']['price'])}</b> монет\n"
                f"• Кот: <i>«{deal['seller']['shop']}»</i> ({deal['seller']['nick']})\n"
                f"• Коорд: <code>{deal['seller']['coords']}</code> (нажмите чтобы скопировать)\n"
                f"• В наличии: <b>{format_coins(deal['seller']['qty'])} шт.</b>\n\n"
                f"🔴 <b>СДАТЬ КОТУ:</b>\n"
                f"• Цена: <b>{format_coins(deal['buyer']['price'])}</b> монет\n"
                f"• Кот: <i>«{deal['buyer']['shop']}»</i> ({deal['buyer']['nick']})\n"
                f"• Коорд: <code>{deal['buyer']['coords']}</code>\n"
                f"• Скупает: <b>{format_coins(deal['buyer']['qty'])} шт.</b>\n\n"
                f"💰 <b>Профит с 1 шт:</b> +{format_coins(deal['profit_per_unit'])} (+{deal['margin_pct']}%)\n"
                f"💵 <b>Суммарная прибыль:</b> <b>+{format_coins(deal['total_profit'])} монет</b>\n"
                f"🔗 <a href=\"{deal['url']}\">Открыть в dbase</a>"
            )
            if send_telegram_message(msg, WEBAPP_URL):
                alert_cache[deal_id] = datetime.datetime.now().isoformat()
                new_alerts_sent += 1
                time.sleep(1)  # Telegram rate limit safety

    # Save cleaned cache (keep only entries from last 2 days)
    two_days_ago = (datetime.datetime.now() - datetime.timedelta(days=2)).isoformat()
    alert_cache = {k: v for k, v in alert_cache.items() if v > two_days_ago}
    save_alert_cache(alert_cache)

    # 3. Save Site Data JSON
    output_data = {
        "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "stats": {
            "total_items_scanned": len(scanned_items),
            "arbitrage_count": len(active_arbitrage),
            "bargains_count": len(bargain_deals)
        },
        "arbitrage": active_arbitrage,
        "bargains": bargain_deals[:30],  # top 30 bargains
        "all_items": [
            {
                "id": x["id"],
                "name": x["name"],
                "category": x["category"],
                "icon": x["icon"],
                "min_sell": x["min_sell"],
                "max_buy": x["max_buy"],
                "median_sell": x["median_sell"]
            }
            for x in scanned_items if (x["min_sell"] > 0 or x["max_buy"] > 0)
        ]
    }

    with open(DATA_JSON_PATH, "w", encoding="utf-8") as f:
        json.dump(output_data, f, ensure_ascii=False, indent=2)

    print(f"[+] Saved updated dashboard data to {DATA_JSON_PATH}")
    print(f"[+] Done! Alerts sent: {new_alerts_sent}")

if __name__ == "__main__":
    main()
